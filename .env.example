# ───────────────────────────────────────────────────────────────
# 全仓库统一的环境变量示例。复制为根目录 .env 后填入真实值即可：
#   cp .env.example .env
# 各 package 下的 .env 是指向根 .env 的软链接，无需单独配置。
# ───────────────────────────────────────────────────────────────

# DashScope（阿里云百炼，兼容 OpenAI 协议）—— 提供 DeepSeek 模型
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方 API
DEEPSEEK_API_KEY=your-deepseek-api-key

# 自定义 OpenAI 兼容端点
CUSTOM_API_KEY=your-custom-api-key

# Brave Search
BRAVE_API_KEY=your-brave-api-key

# 可选：覆盖 pydantic-ai 默认模型（默认 deepseek-v4-pro）
# PYDANTICAI_MODEL=deepseek-v4-pro
